{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "task-envelope",
  "description": "task start 的输入信封（宪法派单六字段 + 绑定信息）。",
  "type": "object",
  "required": ["goal", "scope", "outOfScope", "existingPattern", "verification", "escalation"],
  "properties": {
    "goal": { "type": "string", "minLength": 8, "description": "一个可独立验收的行为切片" },
    "scope": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "允许触碰的文件/模块" },
    "outOfScope": { "type": "array", "items": { "type": "string" } },
    "existingPattern": { "type": "string", "description": "遵循的现有模式/契约文件路径" },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["command", "expect"],
        "properties": { "command": { "type": "string" }, "expect": { "type": "string", "description": "期望输出/退出码" } }
      }
    },
    "escalation": { "type": "string" },
    "refs": {
      "type": "object",
      "properties": {
        "spec": { "type": "string" }, "plan": { "type": "string" }, "adr": { "type": "array", "items": { "type": "string" } }
      }
    },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "ownedPaths": { "type": "array", "items": { "type": "string" } },
    "reviewExclusions": { "type": "array", "items": { "type": "string" } }
  }
}
