#!/bin/sh
# zcode-base :: pre-push — push 是 HIGH 档行为的最后一道自动缝（Task 7.10）。
# doctor + manifest check，任一非 0 阻断；exit 3 显式翻译为「degraded 非 pass」。

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$ROOT" || exit 0

[ -f .zcode/zbase.mjs ] || exit 0

if ! command -v node >/dev/null 2>&1; then
  echo "zcode-base: node 不在 PATH，pre-push 门跳过（跳过不是通过）" >&2
  exit 0
fi

node .zcode/zbase.mjs doctor >/dev/null 2>&1
DOCTOR=$?
if [ "$DOCTOR" = "3" ]; then
  echo "zcode-base: doctor exit 3 —— degraded 状态（检查未配置或有缺口），不是 pass。" >&2
elif [ "$DOCTOR" != "0" ]; then
  echo "zcode-base: doctor 失败（exit $DOCTOR）：node .zcode/zbase.mjs doctor 查看明细。" >&2
fi

MANIFEST=0
if [ -f FRAMEWORK-MANIFEST.json ]; then
  node .zcode/zbase.mjs manifest check >/dev/null 2>&1
  MANIFEST=$?
  if [ "$MANIFEST" = "3" ]; then
    echo "zcode-base: manifest check exit 3 —— 清单漂移（degraded 非 pass）：node .zcode/zbase.mjs manifest generate 后提交。" >&2
  elif [ "$MANIFEST" != "0" ]; then
    echo "zcode-base: manifest check 失败（exit $MANIFEST）：" >&2
    node .zcode/zbase.mjs manifest check 2>&1 | sed -n '1,10p' >&2
  fi
fi

if [ "$DOCTOR" != "0" ] || [ "$MANIFEST" != "0" ]; then
  echo "" >&2
  echo "zcode-base: push 被阻断（doctor exit=$DOCTOR manifest exit=$MANIFEST）。修复后重推；人工绕过须说明理由（HIGH 档）。" >&2
  exit 1
fi

echo "zcode-base: doctor 与 manifest 均通过。" >&2
exit 0
