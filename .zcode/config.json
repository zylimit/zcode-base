{
  "hooks": {
    "enabled": true,
    "timeoutMs": 30000,
    "maxOutputBytes": 65536,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${ZCODE_PROJECT_DIR}/runtime/zbase.mjs\" hook session-start",
              "timeout": 15,
              "statusMessage": "zcode-base 会话恢复"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${ZCODE_PROJECT_DIR}/runtime/zbase.mjs\" hook user-prompt-submit",
              "timeout": 10,
              "statusMessage": "zcode-base 反馈信号检测"
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "node \"${ZCODE_PROJECT_DIR}/runtime/zbase.mjs\" hook pre-tool-use",
              "timeout": 15,
              "statusMessage": "zcode-base 危险命令门禁"
            }
          ]
        },
        {
          "matcher": "Edit|Write|ApplyPatch",
          "hooks": [
            {
              "type": "command",
              "command": "node \"${ZCODE_PROJECT_DIR}/runtime/zbase.mjs\" hook pre-tool-use",
              "timeout": 15,
              "statusMessage": "zcode-base 保护路径门禁"
            }
          ]
        }
      ],
      "PermissionRequest": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "node \"${ZCODE_PROJECT_DIR}/runtime/zbase.mjs\" hook permission-request",
              "timeout": 15,
              "statusMessage": "zcode-base 权限复核"
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "node \"${ZCODE_PROJECT_DIR}/runtime/zbase.mjs\" hook post-tool-use",
              "timeout": 10,
              "statusMessage": "zcode-base 执行留痕"
            }
          ]
        }
      ],
      "PostToolUseFailure": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${ZCODE_PROJECT_DIR}/runtime/zbase.mjs\" hook post-tool-use-failure",
              "timeout": 10,
              "statusMessage": "zcode-base 失败留痕"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${ZCODE_PROJECT_DIR}/runtime/zbase.mjs\" hook stop",
              "timeout": 20,
              "statusMessage": "zcode-base Stop 验证门"
            }
          ]
        }
      ]
    }
  }
}
