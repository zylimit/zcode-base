{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "harness-config",
  "description": "harness/harness.json 项目级覆写（与 .zcode/lib/config.mjs DEFAULTS 深合并）。",
  "type": "object",
  "properties": {
    "version": { "type": "integer" },
    "risk": {
      "type": "object",
      "properties": {
        "confirm": {
          "type": "object",
          "properties": {
            "dangerousCommands": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["rule", "pattern"],
                "properties": { "rule": { "type": "string" }, "pattern": { "type": "string" } }
              }
            },
            "secretReadPatterns": { "type": "array", "items": { "type": "string" } },
            "protectedWritePaths": { "type": "array", "items": { "type": "string" } },
            "secretWritePatterns": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "totalChars": { "type": "integer", "minimum": 10000 },
        "fileChars": { "type": "integer", "minimum": 2000 },
        "diffChars": { "type": "integer" },
        "maxFiles": { "type": "integer", "minimum": 1 },
        "maxTrackedPaths": { "type": "integer", "minimum": 1000 }
      }
    },
    "ledger": {
      "type": "object",
      "properties": { "maxLines": { "type": "integer", "minimum": 1000 } }
    },
    "retention": {
      "type": "object",
      "properties": {
        "evidenceDays": { "type": "integer", "minimum": 1 },
        "gateLogDays": { "type": "integer", "minimum": 1 }
      }
    },
    "fast": {
      "type": "object",
      "properties": { "defaultHours": { "type": "integer", "minimum": 1, "maximum": 720 } }
    }
  }
}
